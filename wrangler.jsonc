{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stubli-home",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/pair", "/health"]
  },
  // Created automatically on the first deploy.
  "kv_namespaces": [{ "binding": "KV" }],
  "triggers": {
    // One schedule for everything: the free plan allows only 5 per account. Each quarter hour,
    // minute :00 collects half the news, :02 the rest, :05 the calendar (events hourly), :10 the weather.
    "crons": ["0,2,5,10,15,17,20,25,30,32,35,40,45,47,50,55 * * * *"]
  },
  "observability": { "enabled": true }
}
