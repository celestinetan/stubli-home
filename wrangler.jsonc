{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stubli-home",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/pair", "/health"]
  },
  // Created automatically on the first deploy.
  "kv_namespaces": [{ "binding": "KV" }],
  "triggers": {
    // One schedule for everything: the free plan allows only 5 per account. News every half hour
    // (:00 and :30 collect half the feeds, :02 and :32 the rest), calendar and weather every quarter
    // hour (:05, :10), events hourly. About 360 storage writes a day, well under the free 1,000.
    "crons": ["0,2,5,10,20,25,30,32,35,40,50,55 * * * *"]
  },
  "observability": { "enabled": true }
}
